{
  "name": "catala-cards",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:py && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "audit": "node tests/audit.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "puppeteer-core": "^23.0.0"
  }
}
